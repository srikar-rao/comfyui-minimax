{
  "template_repo": "https://github.com/srikar-rao/comfyui-minimax.git",
  "branch": "master",
  "provisioning_mode": "walk",
  "auto_download": [
    "HMNSFW-AIO-V2.5.safetensors"
  ],
  "flags": {
    "download_minimax_h3": {
      "workflows": [
        "minimaxH3ReferenceToVideo8_v10_cached.json"
      ]
    },
    "download_viggle_animate": {
      "default": false,
      "folders": [],
      "extra_models": [
        "Viggle-Animate-pruned_rank8_bf16.safetensors",
        "viggle_animate_dmd_lora.safetensors",
        "fixed_embed_fwd_anyframe.safetensors",
        "minimax_h3_video_vae_fp16.safetensors",
        "rife426.pth"
      ]
    }
  },
  "swap_groups": [
    {
      "env": "minimax_quant",
      "default": "int8",
      "flags": [
        "download_minimax_h3"
      ],
      "profiles": {
        "int8": {
          "ref2va": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
          "text_encoder": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
        },
        "fp8": {
          "ref2va": "minimax_h3_ref2va_pruned_fp8_scaled.safetensors",
          "text_encoder": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
        },
        "nvfp4": {
          "ref2va": "minimax_h3_ref2va_pruned_fp8_scaled.safetensors",
          "text_encoder": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
        },
        "false": {
          "ref2va": "minimax_h3_ref2va_bf16.safetensors",
          "text_encoder": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
        },
        "bf16": {
          "ref2va": "minimax_h3_ref2va_bf16.safetensors",
          "text_encoder": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
        }
      }
    }
  ],
  "models_symlink": false,
  "custom_nodes": {
    "target": "image",
    "repos": [
      "https://github.com/LBH-123-AI/Comfyui_Minimax_h3_latent_Upscaler.git|d7c01b9011f2e8439493f6c02c29995a27df276f",
      "https://github.com/Luisacaotica/ComfyUI-MiniMaxH3Mod.git|22ca77e247375dd47fc7340286b5f391887d3410",
      "https://github.com/Saganaki22/ComfyUI-Viggle-Animate-H3.git|77425b6f955e98e96c5e0dc6ca199dc62e63ad8a"
    ],
    "profile_repos": {
      "minimax_quant": {
        "false": [
          "https://github.com/jalberty2018/ComfyUI-Hyperflow.git|90fac72fe147007c6fdfdeb10d5b9068f8eaf919"
        ],
        "bf16": [
          "https://github.com/jalberty2018/ComfyUI-Hyperflow.git|90fac72fe147007c6fdfdeb10d5b9068f8eaf919"
        ]
      }
    }
  },
  "sage": true,
  "comfy_extra_args": "--disable-dynamic-vram",
  "extra_model_paths": [
    "hyperflow",
    "refmods",
    "text_cond"
  ]
}
